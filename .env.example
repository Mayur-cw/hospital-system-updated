# ==============================================================================
# Hospital OS — Environment Variables Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
APP_ENV=development

# Debug mode: NEVER set to true in production
FLASK_DEBUG=false

# Application Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-cryptographically-random-32-byte-hex-string

# Database Connection URI (MySQL 8 / 9 or SQLite)
# Example MySQL: mysql+mysqlclient://hms_user:secure_password@localhost:3306/hms
# Example SQLite (Dev fallback): sqlite:///instance/hms_dev.db
DATABASE_URL=mysql+mysqlclient://hms_user:secure_password@localhost:3306/hms

# Port configuration
PORT=5000
