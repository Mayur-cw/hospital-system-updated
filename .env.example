# ==============================================================================
# Hedgewar Hospital Care — Environment Variables Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
FLASK_APP=hms
FLASK_ENV=development

# Application Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-cryptographically-random-32-byte-hex-string

# Database Connection URI (MySQL 8 / 9 or SQLite)
DATABASE_URL=mysql+pymysql://hms_user:TestPassword%40123@127.0.0.1:3306/hms_test

# Rate Limiter Backend
RATELIMIT_STORAGE_URI=memory://

# Payment Gateway Configuration ('mock' or 'razorpay')
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Outbox / SMTP Configuration
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_DEFAULT_SENDER=no-reply@hedgewar.hospital

# Host Header Whitelist
ALLOWED_HOSTS=localhost,127.0.0.1

# Hospital Branding
HOSPITAL_NAME="Hedgewar Hospital Care"
